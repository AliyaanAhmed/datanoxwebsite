# Generated from content/redirects.ts. Do not edit by hand.

# Security headers. The live site currently sends none of these.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^governance-performancee/?$ /governance-performance/ [R=301,L]
  RewriteRule ^company-2/?$ /company/ [R=301,L]
  RewriteRule ^insurance/?$ /insurance-brokers-management-system/ [R=301,L]
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^category/blog/?$ /blog/ [R=301,L]
